{
  "name": "@taskdaemon/agent-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "Hono agent-gateway: Agent Protocol subset, multi-adapter orchestration, trust hooks",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@taskdaemon/agent-protocol": "workspace:*",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
