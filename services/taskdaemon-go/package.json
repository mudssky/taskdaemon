{
  "name": "@taskdaemon/service-go",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/taskdaemon serve",
    "cli": "go run ./cmd/taskdaemon",
    "install:cli": "go install ./cmd/taskdaemon",
    "dev:desktop": "go tool wails3 dev -config ./build/config.yml -port 9245",
    "desktop": "go run ./cmd/taskdaemon desktop",
    "migrate": "go run ./cmd/taskdaemon db migrate",
    "build": "go build -trimpath -o ../../build/bin/taskdaemon ./cmd/taskdaemon",
    "test": "go test ./...",
    "test:integration": "go test -tags=integration ./internal/data",
    "generate": "go generate ./internal/data/ent",
    "vet": "go vet ./...",
    "service:install": "go run ./cmd/taskdaemon service install",
    "service:status": "go run ./cmd/taskdaemon service status",
    "service:uninstall": "go run ./cmd/taskdaemon service uninstall"
  }
}
